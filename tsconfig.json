{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "out",
		"lib": [
			"es6"
		],
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		/* Additional Checks */
		"noUnusedLocals": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": true,
		"types": ["node", "mocha"]
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
